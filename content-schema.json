{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shams source-reviewed content contract",
  "$defs": {
    "localized": {
      "type": "object",
      "required": [
        "az",
        "tr",
        "ru",
        "en",
        "ar"
      ],
      "properties": {
        "az": {
          "type": "string",
          "minLength": 1
        },
        "tr": {
          "type": "string",
          "minLength": 1
        },
        "ru": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "ar": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "category",
        "difficulty",
        "question",
        "options",
        "correct",
        "explanation",
        "source_reference",
        "source_url",
        "active",
        "reviewed"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "quran",
            "prophets",
            "history",
            "prayer",
            "ramadan",
            "culture",
            "names",
            "general",
            "basics",
            "hadith"
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "question": {
          "$ref": "#/$defs/localized"
        },
        "options": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/localized"
          }
        },
        "correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "explanation": {
          "$ref": "#/$defs/localized"
        },
        "source_reference": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "active": {
          "type": "boolean"
        },
        "reviewed": {
          "type": "boolean"
        },
        "topic": {
          "enum": [
            "quran",
            "prophets",
            "history",
            "prayer",
            "ramadan",
            "basics",
            "hadith",
            "general"
          ]
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "concept_id": {
          "type": "string",
          "minLength": 1
        },
        "option_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "correct_option_id": {
          "type": "string"
        },
        "review_status": {
          "enum": [
            "draft",
            "pending",
            "approved",
            "legacy-reviewed",
            "rejected"
          ]
        },
        "review": {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "source_checked": {
              "type": "boolean"
            },
            "resolution": {
              "type": "string"
            }
          }
        },
        "translation_review": {
          "type": "object"
        },
        "controversial": {
          "type": "boolean"
        }
      }
    },
    "name": {
      "type": "object",
      "required": [
        "id",
        "arabic",
        "latin",
        "meaning",
        "explanation",
        "source_reference",
        "source_url",
        "reviewed",
        "audio"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "arabic": {
          "type": "string"
        },
        "latin": {
          "type": "string"
        },
        "meaning": {
          "$ref": "#/$defs/localized"
        },
        "explanation": {
          "$ref": "#/$defs/localized"
        },
        "source_reference": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "reviewed": {
          "type": "boolean"
        },
        "audio": {
          "type": [
            "string",
            "null"
          ]
        },
        "audio_reviewed": {
          "type": "boolean"
        },
        "audio_license": {
          "type": "string"
        },
        "audio_source_reference": {
          "type": "string"
        }
      }
    },
    "quizBank": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  }
}
